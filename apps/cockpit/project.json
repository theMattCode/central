{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "app-cockpit",
  "projectType": "application",
  "root": "apps/cockpit",
  "sourceRoot": "apps/cockpit/src",
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm exec prettier --write \"src/**/*.{ts,tsx,css}\" \"!src/routeTree.gen.ts\""
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm exec prettier --check \"src/**/*.{ts,tsx,css}\" \"!src/routeTree.gen.ts\""
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm run start:dev"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm run start:preview"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm run test -- --passWithNoTests"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/cockpit",
        "command": "pnpm run typecheck"
      }
    }
  },
  "tags": ["type:app"]
}
