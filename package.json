    "migrate:prod": "sh i12e/orchestrator/scripts/stack.sh prod migrate",
    "prod": "sh i12e/orchestrator/scripts/stack.sh prod up",
    "prod:down": "sh i12e/orchestrator/scripts/stack.sh prod down",
    "ps:dev": "sh i12e/orchestrator/scripts/stack.sh dev ps",
    "ps:prod": "sh i12e/orchestrator/scripts/stack.sh prod ps"
  },
  "private": true,
