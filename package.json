  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@nx/js": "22.5.2",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.13",
    "@swc/helpers": "0.5.19",
    "nx": "22.5.2",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
