{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "i12e-orchestrator",
  "projectType": "application",
  "root": "i12e/orchestrator",
  "sourceRoot": "i12e/orchestrator",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "sh -n i12e/orchestrator/scripts/stack.sh",
          "bash -n i12e/orchestrator/deploy/central-update",
          "docker compose --env-file i12e/orchestrator/.env.dev --file i12e/orchestrator/docker-compose.yml --profile '*' config --quiet",
          "docker compose --env-file i12e/orchestrator/deploy/.env.prod.example --file i12e/orchestrator/deploy/docker-compose.prod.yml config --quiet",
          "docker compose --env-file i12e/orchestrator/deploy/.env.prod.example --file i12e/orchestrator/deploy/docker-compose.prod.yml --file i12e/orchestrator/docker-compose.prod.local.yml config --quiet"
        ],
        "parallel": false
      }
    },
    "smoke-voice": {
      "executor": "nx:run-commands",
      "options": {
        "command": "COMPOSE_PROFILES=voice sh i12e/orchestrator/scripts/stack.sh dev start && python3 i12e/orchestrator/scripts/smoke_voice.py"
      }
    }
  },
  "tags": ["type:infra"]
}
