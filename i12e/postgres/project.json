{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "i12e-postgres",
  "projectType": "application",
  "root": "i12e/postgres",
  "sourceRoot": "i12e/postgres",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "sh -n i12e/postgres/scripts/apply-migrations.sh",
          "sh -n i12e/postgres/scripts/create-migration.sh",
          "sh i12e/postgres/scripts/check-migrations.sh"
        ],
        "parallel": false
      }
    },
    "create-migration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "sh i12e/postgres/scripts/create-migration.sh"
      }
    }
  },
  "tags": ["type:infra"]
}
