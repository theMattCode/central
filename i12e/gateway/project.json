{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "i12e-gateway",
  "projectType": "application",
  "root": "i12e/gateway",
  "sourceRoot": "i12e/gateway",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker run --rm --volume \"$PWD/i12e/gateway/nginx.conf:/etc/nginx/conf.d/default.conf:ro\" nginx:1.29-alpine nginx -t -q"
      }
    }
  },
  "tags": ["type:infra"]
}
